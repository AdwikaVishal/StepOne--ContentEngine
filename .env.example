# ============================================================================
# Content & Design Engine — environment template (cross-platform)
# Copy to `.env` and fill in the real values. Never commit `.env`.
#   Windows: copy .env.example .env
#   macOS/Linux: cp .env.example .env
# ============================================================================

# ── API ─────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:8501

# ── Local paths (relative to the repo root works on every OS) ──────────────
UPLOAD_DIR=uploads
OUTPUT_DIR=output
MODEL_CACHE_DIR=models
LOG_DIR=logs

# ── Upload / retention limits ──────────────────────────────────────────────
MAX_FILE_SIZE_MB=200
UPLOAD_RETENTION_DAYS=7
OUTPUT_RETENTION_DAYS=30

# ── Vision quality thresholds ──────────────────────────────────────────────
FACE_CONFIDENCE_THRESHOLD=0.35
QUALITY_MIN_SCORE=0.30
QUALITY_BLUR_THRESHOLD=300
FACE_SIZE_WEIGHT_THRESHOLD=0.05

# ── Redis / Celery ─────────────────────────────────────────────────────────
# Redis is optional: without it the app uses the in-process APScheduler.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_WORKER_CONCURRENCY=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=50
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_SOFT_TIME_LIMIT=540
FLOWER_PORT=5555
FLOWER_ENABLED=true

# ── Cloud providers (optional; used only when AI_EXECUTION_MODE=cloud_testing)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_SERVICE_TIER=flex
GROQ_TEMPERATURE=0.7
GEMINI_API_KEY=your_gemini_api_key_here

# ── Local LLM backend ──────────────────────────────────────────────────────
# auto  -> MLX if available (Apple Silicon), otherwise PyTorch/transformers
# mlx   -> force the MLX worker (macOS only)
# torch -> force PyTorch/transformers (CUDA on Windows/NVIDIA, CPU fallback)
AI_EXECUTION_MODE=local
LOCAL_LLM_BACKEND=auto

# ── MLX (Apple Silicon only; ignored on Windows) ───────────────────────────
MLX_MODEL_ID=mlx-community/Qwen2.5-0.5B-Instruct-4bit
MLX_MAX_TOKENS=64
MLX_MAX_CONTEXT=1024
MLX_TIMEOUT_SECONDS=120

# ── PyTorch local LLM (Windows / Linux / CPU) ──────────────────────────────
# DEVICE applies to vision models (CLIP/YOLO); Florence-2 always runs on CPU.
DEVICE=cuda
TORCH_DTYPE=float16
TORCH_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
TORCH_LLM_DEVICE=cuda
# Set true after the weights are cached to forbid any network access.
TORCH_LLM_LOCAL_FILES_ONLY=false

# ── Hugging Face cache ─────────────────────────────────────────────────────
HF_HUB_DISABLE_SYMLINKS_WARNING=1
# HF_HOME=%USERPROFILE%\.cache\huggingface
